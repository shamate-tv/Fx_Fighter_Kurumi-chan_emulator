# ==== 数据源开关 ====
# mock = 全部走本地随机游走（无网络、无 key 也能跑）
# live = 按下面各市场的开关接真实行情，缺 key/连不上自动降级 mock
MARKET_DATA=live

# ==== 美股（Alpaca）====
# 在 https://app.alpaca.markets/paper/dashboard/overview 获取 Paper 账户 Key
# 行情走 IEX 实时流，不需要交易权限
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 行情源：iex（免费实时）/ sip（需付费订阅）
ALPACA_FEED=iex

# ==== 外汇（biquote）====
# 免 key，直接连 SignalR hub；连不上会退到 REST 轮询，再失败退到 mock
BIQUOTE_ENABLED=true

# ==== 港股 ====
# 目前只有 Mock，留空即可
HK_PROVIDER=mock

# ==== 账户与时间 ====
INITIAL_USD=10000
INITIAL_HKD=0
USE_SIM_CLOCK=0
TIME_SCALE=60
USDHKD_RATE=7.80

# ==== 生存系统 ====
LIFE_INITIAL_JPY=100000
LIFE_RENT_JPY=35000
LIFE_FOOD_JPY=15000
LIFE_SETTLE_DAYS=7
PLANB_REWARD_JPY=50000
ADVISOR_INTERVAL_DAYS=3
